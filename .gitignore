# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Logs / temp files
*.log
*.tmp
*.bak
.cache/
tmp/
temp/

# Dependency/build folders if added later
node_modules/
dist/
build/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Local auth store (created by server.py; salted password hashes, not plaintext)
accounts.json
accounts.json.tmp

# Local archives/backups
*.zip
*.7z
*.rar

# Internal planning / supplier notes
source-peptide-*.txt
source-peptide-*.md

# Local dev mail drop (password reset emails when SMTP is unconfigured)
outbox/

# SMTP credentials for password-reset email (never commit)
smtp-config.json

# Python bytecode
__pycache__/
*.pyc

# Local order records
orders.json

# Admin allowlist
admin-config.json

# Stock levels
inventory.json

# Anonymous site analytics
analytics.json

affiliates.json

telegram-config.json
