# Knight Labs — HTTPS front door.
#
# Caddy obtains and renews a free Let's Encrypt certificate automatically once
# DNS for the domain points at this server. It also redirects HTTP to HTTPS,
# so customer passwords are never sent in the clear.

__DOMAIN__, www.__DOMAIN__ {
	# The Python app listens on loopback only.
	reverse_proxy 127.0.0.1:__PORT__

	encode gzip zstd

	header {
		# Don't advertise the stack.
		-Server
		# Force HTTPS for a year once a browser has seen this site.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Basic hardening.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The order and reset pages carry tokens in the URL; keep them out of
		# search engines and out of referrer headers.
		X-Robots-Tag "noindex"
	}

	# Pages and shared scripts must never be cached past a deploy.
	#
	# The scripts in /assets are not fingerprinted, so a browser holding an old
	# copy alongside a freshly deployed page will call a function that does not
	# exist yet and abandon the render. That is exactly how the order-received
	# page came to hang on "Loading order details".
	#
	# no-cache does not mean "do not store": the browser revalidates and gets a
	# cheap 304 when nothing changed, so this costs almost nothing.
	@revalidate {
		path *.html *.js *.css /
	}
	header @revalidate Cache-Control "no-cache"

	# Images and fonts are safe to cache; they are replaced rather than edited.
	@static {
		path *.png *.jpg *.jpeg *.svg *.ico *.webp *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=604800"

	# Data files must never be reachable over HTTP, even if one is ever placed
	# in the app directory by mistake.
	@blocked {
		path /accounts.json /orders.json /inventory.json /analytics.json
		path /smtp-config.json /admin-config.json /affiliates.json
		path /outbox/* /deploy/* /.git/* /*.py /*.bat /*.sh
	}
	respond @blocked 404

	log {
		output file /var/log/caddy/knight-labs.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
